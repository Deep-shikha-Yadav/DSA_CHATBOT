{
  "version": 2,
  "builds": [
    {
      "src": "DSA.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "dest": "DSA.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}